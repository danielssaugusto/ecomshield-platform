# ── Database ──────────────────────────────────────────────
DATABASE_URL=postgresql://ecomshield:ecomshield_dev@db:5432/ecomshield

# ── PostgreSQL (used by the db service in compose.yml) ───
POSTGRES_USER=ecomshield
POSTGRES_PASSWORD=ecomshield_dev
POSTGRES_DB=ecomshield

# ── JWT / Auth ────────────────────────────────────────────
SECRET_KEY=chave_dev_temporaria_altere_no_arquivo_env
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ── Application ──────────────────────────────────────────
APP_NAME=EcomShield API
