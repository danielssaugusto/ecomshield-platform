# ── Database ──────────────────────────────────────────────
DATABASE_URL=postgresql://ecomshield:ecomshield_dev@db:5432/ecomshield

# ── PostgreSQL (used by the db service in compose.yml) ───
POSTGRES_USER=ecomshield
POSTGRES_PASSWORD=ecomshield_dev
POSTGRES_DB=ecomshield

# ── JWT / Auth ────────────────────────────────────────────
# Configure uma chave aleatória persistente para manter os tokens válidos após reiniciar.
# Exemplo: python -c "import secrets; print(secrets.token_urlsafe(48))"
# SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
# Defina uma senha forte localmente para criar o admin no primeiro boot.
# ADMIN_BOOTSTRAP_PASSWORD=

# ── Application ──────────────────────────────────────────
APP_NAME=EcomShield API
